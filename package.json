{
  "name": "skill-atlas",
  "version": "0.1.0",
  "private": true,
  "description": "Skill Atlas: every SKILL.md in a repository, in the terminal.",
  "type": "module",
  "bin": {
    "skill-atlas": "src/cli.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "npm run test:unit && npm run test:demo",
    "test:unit": "node --test tests/*.test.ts tests/e2e/layout.test.ts",
    "test:demo": "playwright test",
    "test:e2e": "node --test tests/e2e/*.test.ts",
    "typecheck": "tsc --noEmit",
    "qa:browse": "node qa/browse.ts",
    "qa:steps": "node qa/steps.ts",
    "qa:scenarios": "node qa/scenarios.ts"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.0",
    "linkedom": "^0.18.15",
    "typescript": "^7.0.2"
  }
}
